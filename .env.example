# Google OAuth (required for user Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js — use a long random string in production
AUTH_SECRET=convert-my-file-dev-secret-change-me
NEXTAUTH_SECRET=convert-my-file-dev-secret-change-me
NEXTAUTH_URL=http://127.0.0.1:43127
AUTH_URL=http://127.0.0.1:43127

# Admin panel — Google allowlist (comma-separated). Non-admins get 404.
ADMIN_EMAILS=bapattanmay@gmail.com

# Premium desk — Google allowlist (comma-separated). Also unlockable via mock Upgrade.
PREMIUM_EMAILS=bapattanmay@gmail.com

# Usage / analytics store directory (file fallback when DATABASE_URL unset)
DATA_DIR=./data
SESSION_SECRET=convert-my-file-dev-secret-change-me

# Durable analytics (Render Postgres / any Postgres). Survives web redeploys.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=1

# Translator (optional)
# Free path uses MyMemory with no key (daily quota / ~500 chars per chunk).
# MYMEMORY_EMAIL=you@example.com
# Optional paid/higher-quality path when set:
# GOOGLE_TRANSLATE_API_KEY=
