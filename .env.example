# Google OAuth (required for Premium / admin Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js — required in production (fail-closed; no defaults)
AUTH_SECRET=convert-my-file-dev-secret-change-me
NEXTAUTH_SECRET=convert-my-file-dev-secret-change-me
NEXTAUTH_URL=http://127.0.0.1:43127
AUTH_URL=http://127.0.0.1:43127

# Admin panel — Google allowlist (required in production)
ADMIN_EMAILS=bapattanmay@gmail.com

# Premium desk — server allowlist only (no mock cookie unlock)
PREMIUM_EMAILS=bapattanmay@gmail.com

# Usage / analytics store directory (file fallback when DATABASE_URL unset)
DATA_DIR=./data
SESSION_SECRET=convert-my-file-dev-secret-change-me

# Durable analytics (Render Postgres / any Postgres). Survives web redeploys.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=1

# Translator (optional)
# MYMEMORY_EMAIL=you@example.com
# GOOGLE_TRANSLATE_API_KEY=
